# Amelia - environment configuration. Copy to .env and fill in values.
# Never commit .env.

# --- LLM provider (any OpenAI-compatible endpoint) ---
# Gemini:  OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  OPENAI_MODEL=gemini-2.5-flash
# Groq:    OPENAI_BASE_URL=https://api.groq.com/openai/v1                            OPENAI_MODEL=openai/gpt-oss-120b
# OpenAI:  leave OPENAI_BASE_URL empty                                                OPENAI_MODEL=gpt-4o
# Voice mode (voice_server.py) needs a real OpenAI key, because it uses the Realtime API.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- Core-banking API (auth, balance, transfer, transactions, block-card, cheque-debit) ---
BANK_API_BASE_URL=http://localhost:9000/api
# Optional override for the cheque debit endpoint only
CHEQUE_DEBIT_API_URL=

# --- Cheque validation ---
CHEQUE_BANK_NAME=DEMO BANK
MICR_PREFIXES=632,633
